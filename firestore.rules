rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // REUSABLE FUNCTIONS
    // ==========================================

    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    // Revoked admins keep their doc with isAdmin: false, so the flag decides, not the doc.
    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.get('isAdmin', false) == true;
    }

    // Mirrors useQuestionnaireSubmit's payload; answers are free-form but bounded.
    function isValidQuestionnaire(data) {
      return data.keys().hasOnly(['niche', 'locale', 'answers', 'files', 'createdAt'])
        && data.keys().hasAll(['niche', 'locale', 'answers', 'files', 'createdAt'])
        && data.niche in ['cafe', 'health', 'music']
        && data.locale in ['en', 'es']
        && data.answers is map && data.answers.size() <= 120
        && data.files is list && data.files.size() <= 60
        && data.createdAt == request.time;
    }

    // ==========================================
    // QUESTIONNAIRES
    // ==========================================
    //
    // Visitors sign in anonymously and create one document under their uid.
    // They can never read, update or delete it; only admins read submissions.

    match /questionnaires/{uid} {
      allow create: if isSignedIn() && request.auth.uid == uid && isValidQuestionnaire(request.resource.data);
      allow read: if isAdmin();
    }

    match /admins/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
    }
  }
}
