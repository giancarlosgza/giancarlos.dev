{
  "name": "nuxt-app",
  "version": "2.8.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "dev:host": "nuxt dev --host",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "install:safe": "npm install --ignore-scripts",
    "install:ci": "npm ci --ignore-scripts && npm run postinstall",
    "install:latest": "npm install --ignore-scripts --min-release-age=0",
    "audit:signatures": "npm audit signatures",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "npx nuxt typecheck",
    "sass:map": "sass --source-map app/assets/scss:app/assets/css",
    "generate-pwa-assets": "pwa-assets-generator --preset minimal-2023 public/icon-pwa.svg",
    "version:patch": "npm version patch",
    "version:minor": "npm version minor",
    "version:major": "npm version major"
  },
  "dependencies": {
    "@colorffy/css": "2.0.1",
    "@colorffy/ui": "2.0.1",
    "@material-symbols/font-700": "0.46.0",
    "@vite-pwa/nuxt": "1.1.1",
    "@vueuse/components": "14.4.0",
    "firebase": "12.18.0",
    "floating-vue": "5.2.2",
    "vue": "3.5.41",
    "vue-router": "5.2.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "9.3.0",
    "@nuxt/devtools": "3.4.1",
    "@nuxt/fonts": "0.14.0",
    "@nuxt/image": "2.1.0",
    "@nuxt/scripts": "1.3.6",
    "@nuxtjs/color-mode": "4.0.1",
    "@nuxtjs/robots": "6.1.5",
    "@nuxtjs/sitemap": "8.3.4",
    "@types/node": "26.2.0",
    "@vite-pwa/assets-generator": "1.0.2",
    "@vueuse/core": "14.4.0",
    "@vueuse/nuxt": "14.4.0",
    "eslint": "10.8.1",
    "nuxt": "^4.5.2",
    "nuxt-vuefire": "1.1.2",
    "sass": "1.102.0",
    "sass-loader": "17.0.0",
    "typescript": "6.0.3",
    "vue-tsc": "3.3.10",
    "vuefire": "3.2.3"
  },
  "overrides": {
    "sharp": "0.33.5"
  }
}
