{
  "name": "nuxt-app",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "dev:host": "nuxt dev --host",
    "generate": "nuxt generate",
    "generate:prod": "nuxt generate --dotenv .env.production",
    "deploy": "npm run generate:prod && firebase deploy --only hosting",
    "deploy:only": "firebase deploy --only hosting",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "install:safe": "npm install --ignore-scripts",
    "install:ci": "npm ci --ignore-scripts && npm run postinstall",
    "install:latest": "npm install --ignore-scripts --min-release-age=0",
    "audit:signatures": "npm audit signatures",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "npx nuxt typecheck",
    "sass:map": "sass --source-map app/assets/scss:app/assets/css",
    "generate-pwa-assets": "pwa-assets-generator --preset minimal-2023 public/icon-pwa.svg",
    "version:patch": "npm version patch",
    "version:minor": "npm version minor",
    "version:major": "npm version major"
  },
  "dependencies": {
    "@colorffy/css": "3.0.0",
    "@colorffy/ui": "3.0.0",
    "@material-symbols/font-700": "0.48.2",
    "@nuxtjs/i18n": "10.6.0",
    "@paper-design/shaders": "0.0.82",
    "@vite-pwa/nuxt": "1.1.1",
    "@vueuse/components": "15.0.0",
    "firebase": "12.19.0",
    "floating-vue": "5.4.0",
    "vue": "3.5.44",
    "vue-router": "5.4.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "9.5.1",
    "@nuxt/devtools": "3.4.4",
    "@nuxt/fonts": "0.14.0",
    "@nuxt/image": "2.2.1",
    "@nuxt/scripts": "1.3.12",
    "@nuxtjs/color-mode": "4.1.0",
    "@nuxtjs/robots": "6.2.4",
    "@nuxtjs/sitemap": "8.6.2",
    "@types/node": "26.6.6",
    "@vite-pwa/assets-generator": "1.0.4",
    "@vueuse/core": "15.0.0",
    "@vueuse/nuxt": "15.0.0",
    "eslint": "10.14.0",
    "nuxt": "^4.6.3",
    "nuxt-vuefire": "1.1.2",
    "sass": "1.107.1",
    "sass-loader": "17.1.0",
    "typescript": "6.0.3",
    "vue-tsc": "3.3.11",
    "vuefire": "3.2.3"
  },
  "overrides": {
    "sharp": "0.33.5"
  }
}
